# Install as /etc/video-collector/collector.env, mode 0600; never commit real secrets.
COLLECTOR_CONFIG=/etc/video-collector/config.json
COLLECTOR_PUBLIC_ORIGIN=https://collect.example.com
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COLLECTOR_ACCESS_TOKEN=
DTK_API_KEY=
# Zhiling remains disabled in config.example.json; set only when explicitly enabled.
ZHILING_API_KEY=
