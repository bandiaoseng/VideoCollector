[Unit]
Description=Video Collector independent download and Quark worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=video-collector
Group=video-collector
WorkingDirectory=/var/lib/video-collector
Environment=HOME=/var/lib/video-collector
EnvironmentFile=/etc/video-collector/collector.env
StateDirectory=video-collector
StateDirectoryMode=0700
ExecStart=/opt/video-collector/.venv/bin/python /opt/video-collector/worker.py
Restart=on-failure
RestartSec=10
# Allow a bounded download+upload to finish on normal shutdown.
TimeoutStopSec=9000
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/video-collector

[Install]
WantedBy=multi-user.target
